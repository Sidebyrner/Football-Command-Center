VITE_ODDS_API_KEY=your_key_here
# Optional: self-hosted API proxy (see server/). When set, the app prefers
# it for odds and news and falls back to direct calls if it's unreachable.
# Leave unset to use the app exactly as before B1/B2 existed.
VITE_API_BASE_URL=http://192.168.0.8:8080
VITE_DEFAULT_SEASON=2026
VITE_DEFAULT_WEEK=1

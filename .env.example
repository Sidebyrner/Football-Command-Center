# Optional. Without it the odds pages fall back to the free recorded lines in
# public/data/schedule-*.json (labelled as recorded, since they don't move as
# the week does). Set it for live lines. Can also be pasted in Settings.
VITE_ODDS_API_KEY=

# Optional: self-hosted API proxy (see server/). When set, the app prefers
# it for odds and news and falls back to direct calls if it's unreachable.
# Leave unset to use the app exactly as before B1/B2 existed.
#
# News import and the LM Studio summaries are OFF unless this is set — they
# have no direct-fetch path (RSS and the model both need the relay).
# Running the server on the same machine:  http://localhost:8080
# Running it elsewhere on the LAN/tailnet: http://<host>:8080
VITE_API_BASE_URL=http://localhost:8080

VITE_DEFAULT_SEASON=2026
VITE_DEFAULT_WEEK=1
